# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in real values. NEVER commit `.env.local`.
# `.env.local` is gitignored on purpose (security checklist #3).
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase (from your project's dashboard: "Connect" dialog or Settings) ------
# Safe for the browser. Respects Row Level Security. The NEXT_PUBLIC_ prefix means
# Next.js inlines these into client-side bundles — that is fine ONLY for these two.
# The "publishable" key is Supabase's current name for the public, RLS-bound key
# (successor to the classic `anon` key).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# SERVER-ONLY. A Supabase "secret" key (successor to service_role) bypasses RLS =
# full database access. Must NEVER get a NEXT_PUBLIC_ prefix and NEVER be imported
# into a client component. Not used by any code yet — add only when a feature needs
# to bypass RLS. If it leaks, anyone can read/write every user's data. (checklist #1)
SUPABASE_SECRET_KEY=your-secret-key

# --- Public site URL (used to build magic-link redirect URLs) --------------------
# Locally: http://localhost:3000  •  In prod: https://toolkit.roadtotheclosingtable.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- GoHighLevel (GHL) webhook — app → GHL, one way only ------------------------
# The inbound webhook URL GHL gives you, plus a shared secret we send with each call
# so GHL can confirm the request really came from this app. SERVER-ONLY.
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/YOUR-INBOUND-WEBHOOK
GHL_WEBHOOK_SECRET=generate-a-long-random-string

# FRED (Federal Reserve data) API key for Market Watch — free at fred.stlouisfed.org
# My Account -> API Keys. SERVER-ONLY: never NEXT_PUBLIC_.
FRED_API_KEY=paste-your-key-here

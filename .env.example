# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in real values. NEVER commit `.env.local`.
# `.env.local` is gitignored on purpose (security checklist #3).
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase (from your project's Settings → API) -------------------------------
# Safe for the browser. Respects Row Level Security. The NEXT_PUBLIC_ prefix means
# Next.js will inline it into client-side bundles — that is fine ONLY for these two.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY. Bypasses RLS entirely = full database access. This must NEVER get a
# NEXT_PUBLIC_ prefix and must NEVER be imported into a client component. If this key
# leaks, anyone can read/write every user's data. (security checklist #1)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Public site URL (used to build magic-link redirect URLs) --------------------
# Locally: http://localhost:3000  •  In prod: https://toolkit.roadtotheclosingtable.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- GoHighLevel (GHL) webhook — app → GHL, one way only ------------------------
# The inbound webhook URL GHL gives you, plus a shared secret we send with each call
# so GHL can confirm the request really came from this app. SERVER-ONLY.
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/YOUR-INBOUND-WEBHOOK
GHL_WEBHOOK_SECRET=generate-a-long-random-string
